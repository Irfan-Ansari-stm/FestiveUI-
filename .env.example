# Environment Variables Template
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/festiveui_db?schema=public"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET="festiveui_super_secret_jwt_access_key_2026"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="festiveui_super_secret_jwt_refresh_key_2026"
JWT_REFRESH_EXPIRATION="7d"

# Payment Providers (Test credentials)
STRIPE_SECRET_KEY="sk_test_festiveui_stripe_sample_key"
STRIPE_WEBHOOK_SECRET="whsec_festiveui_sample_webhook_secret"
RAZORPAY_KEY_ID="rzp_test_festiveui_key_id"
RAZORPAY_KEY_SECRET="festiveui_razorpay_secret"

# App URLs
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
